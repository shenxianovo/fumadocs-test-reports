{
  "name": "fumadocs-test-reports",
  "version": "0.1.1",
  "description": "Test report integration for Fumadocs",
  "keywords": [
    "fumadocs",
    "react",
    "test-report",
    "tunit",
    "vitest"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenxianovo/fumadocs-test-reports.git",
    "directory": "packages/test-reports"
  },
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": [
    "./css/**/*.css"
  ],
  "exports": {
    "./i18n": "./dist/i18n/index.js",
    "./tunit": "./dist/tunit/index.js",
    "./tunit/ui": "./dist/tunit/ui/index.js",
    "./ui": "./dist/ui/index.js",
    "./vitest": "./dist/vitest/index.js",
    "./vitest/ui": "./dist/vitest/ui/index.js",
    "./css/*": "./css/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "prepack": "pnpm build",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fuma-translate/react": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fumadocs-core": "16.16.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0"
  },
  "peerDependencies": {
    "fumadocs-core": "^16.16.2",
    "fumadocs-ui": "^16.16.2",
    "react": "^19.2.0"
  }
}
